APP_NAME=TaskFlow
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
API_VERSION=1.0.0
# Comma-separated hostnames allowed to reach the Nuxt/Vite dev server
# (Host header check). Add e.g. your LAN IP or custom domain here.
ALLOWED_HOSTS=localhost,127.0.0.1
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_EN
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

VITE_APP_NAME="${APP_NAME}"
JWT_SECRET=

# Token lifetimes (uniform policy: access 60 min, refresh window 7 days)
SANCTUM_EXPIRATION=60                  # minutes; Sanctum access-token lifetime
SANCTUM_REFRESH_WINDOW=7               # days; how long an expired Sanctum token may be rotated
JWT_TTL=60                             # minutes; JWT access-token lifetime
JWT_REFRESH_TTL=10080                  # minutes (7 days); JWT refresh window
PASSPORT_TOKEN_EXPIRATION_MINUTES=60   # minutes; Passport access-token lifetime
PASSPORT_REFRESH_TOKEN_EXPIRATION_DAYS=7 # days; Passport refresh-token lifetime
